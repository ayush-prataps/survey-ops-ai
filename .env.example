# LLM
GEMINI_API_KEY=
# Database
POSTGRES_URL=postgresql://surveyops:surveyops@postgres:5432/surveyops
# GitHub (Remediator: minimal scope, PR rights only, no merge)
GITHUB_TOKEN=
TARGET_REPO_URL=
# Security
INVESTIGATE_SHARED_SECRET=
# Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Guardrail limits
MAX_LOOP_ITERATIONS=6
MAX_LOAD_BURST_CONCURRENCY=20
MAX_LOAD_BURST_SECONDS=15

CREWAI_TRACING_ENABLED=false

# Target App Infrastructure & Pool Configuration
TARGET_APP_POSTGRES_HOST=postgres
TARGET_APP_POSTGRES_PORT=5432
TARGET_APP_POSTGRES_DB=target_app
TARGET_APP_POSTGRES_USER=postgres
TARGET_APP_POSTGRES_PASSWORD=postgres
PAYMENT_POOL_SIZE=5
PAYMENT_MAX_OVERFLOW=0
PAYMENT_POOL_TIMEOUT=5.0

# Traffic Generator (Locust)
LOCUST_USERS=5
LOCUST_SPAWN_RATE=2
LOCUST_MIN_WAIT=1.0
LOCUST_MAX_WAIT=3.0